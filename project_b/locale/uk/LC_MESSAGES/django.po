msgstr "дата створення"

msgid "reservation"
msgstr "резервування"

msgid "reservations"
msgstr "резервування"

msgid "quantity"
msgstr "кількість"

msgid "reservation item"
msgstr "позиція резервування"

msgid "reservation items"
msgstr "позиції резервування"

msgid "Reservation not found."
msgstr "Резервування не знайдено."

msgid "An expired reservation cannot be confirmed."
msgstr "Неможливо підтвердити резервування, термін дії якого минув."

msgid "Only pending reservations can be confirmed."
msgstr "Можна підтвердити лише резервування, що очікують підтвердження."

msgid "Only pending reservations can be released."
msgstr "Можна звільнити лише резервування, що очікують підтвердження."

msgid "Each book must appear only once in a reservation."
msgstr "Кожна книга має бути вказана в резервуванні лише один раз."

msgid "The reservation conflicts with the warehouse state."
msgstr "Резервування суперечить поточному стану складу."

msgid "Create a reservation"
msgstr "Створити резервування"

msgid "Confirm a reservation"
msgstr "Підтвердити резервування"

msgid "Release a reservation"
msgstr "Звільнити резервування"

msgid "A reservation must contain between 1 and 100 items."
msgstr "Резервування має містити від 1 до 100 позицій."

msgid "Each item must contain external_book_id and quantity."
msgstr "Кожна позиція має містити external_book_id та quantity."

msgid "Invalid book ID."
msgstr "Некоректний ID книги."

msgid "Invalid book quantity."
msgstr "Некоректна кількість книг."

msgid "Invalid order ID."
msgstr "Некоректний ID замовлення."

msgid "This order already has a reservation with different items."
msgstr "Для цього замовлення вже існує резервування з іншими позиціями."

msgid "This reservation is no longer active."
msgstr "Це резервування більше не активне."

